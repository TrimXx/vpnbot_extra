{
    "auto-transports": true,
    "vpnbot-app-groups": [
        {
            "name": "AppOne",
            "provider": "appone",
            "url": "https://example.com/rules/appone.mrs",
            "interval": 86400,
            "behavior": "domain"
        },
        {
            "name": "AppTwo",
            "provider": "apptwo",
            "url": "https://example.com/rules/apptwo.mrs",
            "interval": 86400,
            "behavior": "domain"
        }
    ],
    "mixed-port": 2080,
    "allow-lan": true,
    "tcp-concurrent": true,
    "enable-process": true,
    "find-process-mode": "strict",
    "mode": "rule",
    "log-level": "info",
    "ipv6": false,
    "keep-alive-interval": 60,
    "unified-delay": false,
    "profile": {
        "store-selected": true,
        "store-fake-ip": true
    },
    "sniffer": {
        "enable": true,
        "sniff": {
            "HTTP": {
                "ports": [
                    80,
                    "8080-8880"
                ],
                "override-destination": true
            },
            "TLS": {
                "ports": [
                    443,
                    8443
                ]
            },
            "QUIC": {
                "ports": [
                    443,
                    8443
                ]
            }
        }
    },
    "tun": {
        "enable": true,
        "stack": "mixed",
        "dns-hijack": [
            "any:53"
        ],
        "auto-route": true,
        "auto-detect-interface": true,
        "strict-route": true
    },
    "dns": {
        "enable": true,
        "listen": ":1053",
        "prefer-h3": false,
        "ipv6": false,
        "enhanced-mode": "fake-ip",
        "fake-ip-filter": [
            "~domain~",
            "+.lan",
            "+.local"
        ],
        "nameserver": [
            "~dns~"
        ]
    },
    "proxies": [
        {
            "name": "~outbound~",
            "type": "vless",
            "server": "~reality_server_host~",
            "port": "~port_reality~",
            "uuid": "~uid~",
            "network": "tcp",
            "flow": "xtls-rprx-vision",
            "udp": true,
            "tls": true,
            "reality-opts": {
                "public-key": "~public_key~",
                "short-id": "~short_id~"
            },
            "servername": "~server_name~",
            "client-fingerprint": "~client_fingerprint~"
        }
    ],
    "proxy-groups": [
        {
            "name": "PROXY",
            "type": "select",
            "proxies": [
                "~outbound~"
            ]
        },
        {
            "name": "AppOne",
            "type": "select",
            "proxies": [
                "PROXY",
                "DIRECT",
                "~outbound~"
            ]
        },
        {
            "name": "AppTwo",
            "type": "select",
            "proxies": [
                "PROXY",
                "DIRECT",
                "~outbound~"
            ]
        }
    ],
    "add-rule-providers": false,
    "rule-providers": {
        "appone": {
            "type": "http",
            "behavior": "domain",
            "format": "mrs",
            "url": "https://example.com/rules/appone.mrs",
            "interval": 86400
        },
        "apptwo": {
            "type": "http",
            "behavior": "domain",
            "format": "mrs",
            "url": "https://example.com/rules/apptwo.mrs",
            "interval": 86400
        }
    },
    "rules": [
        {
            "type": "RULE-SET",
            "list": "~block~",
            "action": "REJECT",
            "interval": 60,
            "behavior": "classical",
            "name": "block"
        },
        {
            "type": "RULE-SET",
            "list": "appone",
            "action": "AppOne",
            "name": "appone",
            "interval": 86400,
            "behavior": "domain"
        },
        {
            "type": "RULE-SET",
            "list": "apptwo",
            "action": "AppTwo",
            "name": "apptwo",
            "interval": 86400,
            "behavior": "domain"
        },
        {
            "type": "RULE-SET",
            "list": "~process~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "process"
        },
        {
            "type": "RULE-SET",
            "list": "~package~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "package"
        },
        {
            "type": "RULE-SET",
            "list": "~warp~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "warp"
        },
        {
            "type": "RULE-SET",
            "list": "~pac~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "pac"
        },
        {
            "type": "RULE-SET",
            "list": "~subnet~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "subnet"
        },
        {
            "type": "MATCH",
            "action": "DIRECT"
        }
    ]
}
