{
    "auto-transports": false,
    "mixed-port": 2080,
    "allow-lan": true,
    "tcp-concurrent": true,
    "enable-process": true,
    "find-process-mode": "strict",
    "mode": "rule",
    "log-level": "info",
    "ipv6": false,
    "keep-alive-interval": 60,
    "unified-delay": false,
    "profile": {
        "store-selected": true,
        "store-fake-ip": true
    },
    "sniffer": {
        "enable": true,
        "sniff": {
            "HTTP": {
                "ports": [
                    80,
                    "8080-8880"
                ],
                "override-destination": true
            },
            "TLS": {
                "ports": [
                    443,
                    8443
                ]
            },
            "QUIC": {
                "ports": [
                    443,
                    8443
                ]
            }
        }
    },
    "tun": {
        "enable": true,
        "stack": "mixed",
        "dns-hijack": [
            "any:53"
        ],
        "auto-route": true,
        "auto-detect-interface": true,
        "strict-route": true
    },
    "dns": {
        "enable": true,
        "listen": ":1053",
        "prefer-h3": false,
        "ipv6": false,
        "enhanced-mode": "fake-ip",
        "fake-ip-filter": [
            "~domain~",
            "~directdomain~",
            "~domain_alt~",
            "+.lan",
            "+.local"
        ],
        "nameserver": [
            "~dns~"
        ]
    },
    "proxies": [
        {
            "name": "~outbound~",
            "type": "vless",
            "server": "~reality_server_host~",
            "port": "~port_reality~",
            "uuid": "~uid~",
            "network": "tcp",
            "flow": "xtls-rprx-vision",
            "udp": true,
            "tls": true,
            "reality-opts": {
                "public-key": "~public_key~",
                "short-id": "~short_id~"
            },
            "servername": "~server_name~",
            "client-fingerprint": "~client_fingerprint~"
        },
        {
            "name": "WS1",
            "type": "vless",
            "server": "~directdomain~",
            "port": "~port_ws~",
            "uuid": "~uid~",
            "network": "ws",
            "udp": true,
            "tls": true,
            "servername": "~directdomain~",
            "client-fingerprint": "~client_fingerprint~",
            "ws-opts": {
                "path": "~ws_path~"
            }
        },
        {
            "name": "WS2",
            "type": "vless",
            "server": "~domain_alt~",
            "port": "~port_ws~",
            "uuid": "~uid~",
            "network": "ws",
            "udp": true,
            "tls": true,
            "servername": "~directdomain~",
            "client-fingerprint": "~client_fingerprint~",
            "ws-opts": {
                "path": "~ws_path~"
            }
        },
        {
            "name": "Reality1",
            "type": "vless",
            "server": "~reality_server_host~",
            "port": "~port_reality~",
            "uuid": "~uid~",
            "network": "tcp",
            "flow": "xtls-rprx-vision",
            "udp": true,
            "tls": true,
            "servername": "~server_name~",
            "client-fingerprint": "~client_fingerprint~",
            "reality-opts": {
                "public-key": "~public_key~",
                "short-id": "~short_id~"
            }
        },
        {
            "name": "Reality2",
            "type": "vless",
            "server": "~domain_alt~",
            "port": "~port_reality~",
            "uuid": "~uid~",
            "network": "tcp",
            "flow": "xtls-rprx-vision",
            "udp": true,
            "tls": true,
            "servername": "~server_name~",
            "client-fingerprint": "~client_fingerprint~",
            "reality-opts": {
                "public-key": "~public_key~",
                "short-id": "~short_id~"
            }
        },
        {
            "name": "HY2",
            "type": "hysteria2",
            "server": "~domain~",
            "port": "~port_hy~",
            "password": "~hy_password~",
            "sni": "~directdomain~",
            "alpn": [
                "h3"
            ]
        }
    ],
    "proxy-groups": [
        {
            "name": "PROXY",
            "type": "fallback",
            "url": "http://www.gstatic.com/generate_204",
            "interval": 300,
            "lazy": true,
            "proxies": [
                "WS1",
                "WS2",
                "Reality1",
                "Reality2",
                "HY2"
            ]
        }
    ],
    "add-rule-providers": true,
    "rule-providers": {},
    "rules": [
        {
            "type": "RULE-SET",
            "list": "~block~",
            "action": "REJECT",
            "interval": 60,
            "behavior": "classical",
            "name": "block"
        },
        {
            "type": "PROCESS-NAME",
            "list": [
                "Discord.exe"
            ],
            "action": "PROXY"
        },
        {
            "type": "RULE-SET",
            "list": "~process~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "process"
        },
        {
            "type": "RULE-SET",
            "list": "~package~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "package"
        },
        {
            "type": "RULE-SET",
            "list": "~warp~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "warp"
        },
        {
            "type": "RULE-SET",
            "list": "~pac~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "pac"
        },
        {
            "type": "RULE-SET",
            "list": "~subnet~",
            "action": "PROXY",
            "interval": 60,
            "behavior": "classical",
            "name": "subnet"
        },
        {
            "type": "MATCH",
            "action": "DIRECT"
        }
    ]
}
